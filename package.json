{
  "name": "solvix",
  "version": "0.1.0",
  "description": "Scientific computing for TypeScript with multidimensional arrays and numerical operations",
  "type": "module",
  "main": "./dist/src/ix/index.js",
  "types": "./dist/src/ix/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/ix/index.d.ts",
      "import": "./dist/src/ix/index.js"
    }
  },
  "files": [
    "dist/src/ix"
  ],
  "scripts": {
    "dev": "tsc --watch --preserveWatchOutput",
    "build": "tsc",
    "test": "vitest run tests/ix",
    "example": "tsx examples/quickstart.ts",
    "bench": "tsx benchmarks/bench-ix.ts",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "mitata": "^1.0.34",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
